# Server
NODE_ENV=development
PORT=3000
INSTANCE_ID=app1                       # shown in /healthz, logs and the UI badge
PUBLIC_URL=http://localhost:8080       # used for the OIDC redirect URI
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001,http://localhost:3002
TRUST_PROXY=1                          # number of proxy hops in front (nginx = 1). Use 0 when hitting Node directly
LOG_LEVEL=info

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=omc                       # every key and channel starts with this

# OIDC (Google by default — any OIDC issuer works)
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_PATH=/auth/callback
OIDC_SCOPES=openid profile email

# Local-only shortcut: /auth/dev-login?name=Alice creates a session without OIDC.
# Refused at boot when NODE_ENV=production.
DEV_LOGIN=false

# Sessions
SESSION_COOKIE_NAME=omc_sid
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false                    # true in production (HTTPS)

# Board
BOARD_SIZE=1000000
BOARD_COLS=1000
BROADCAST_INTERVAL_MS=50
RESYNC_GAP=500
BOARD_LOG_LENGTH=10000                 # replay log length (Redis Stream) for reconnecting clients

# Rate limits
RL_HTTP_API_LIMIT=120
RL_HTTP_API_WINDOW_S=60
RL_HTTP_AUTH_LIMIT=20
RL_HTTP_AUTH_WINDOW_S=60
RL_WS_BUCKET_CAPACITY=10
RL_WS_BUCKET_REFILL_PER_S=5
RL_WS_USER_LIMIT=20
RL_WS_USER_WINDOW_MS=1000
RL_WS_STRIKES_TO_BLOCK=10
RL_WS_STRIKE_WINDOW_S=60
RL_WS_BLOCK_SECONDS=120
RL_WS_BLOCKS_TO_CLOSE=3
RL_MAX_CONN_PER_IP=10
RL_CONN_PER_MINUTE=30
