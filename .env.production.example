# Copy to .env ON THE SERVER (never commit .env). Fill in the blanks.
# Free HTTPS hostname without owning a domain: <server-ip-with-dashes>.sslip.io
#   e.g. IP 132.145.1.2 -> 132-145-1-2.sslip.io
DOMAIN=your-domain.example
PUBLIC_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example

NODE_ENV=production
COOKIE_SECURE=true
DEV_LOGIN=false
LOG_LEVEL=info

OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
